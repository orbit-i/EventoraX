# ==============================================================
# EventoraX Environment Configuration
# Designed for Hostinger Unlimited / Business Web Hosting (Node.js + MySQL)
# ==============================================================

# Server Port (Hostinger Passenger sets process.env.PORT automatically, or uses 5000)
PORT=5000
NODE_ENV=production

# Hostinger MySQL Database Settings
# On Hostinger, DB_HOST is usually 'localhost' or '127.0.0.1'
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=eventorax_db

# Security & Authentication Secret Key
JWT_SECRET=eventorax_production_jwt_secret_key_2025_secure
