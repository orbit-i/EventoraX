# ==============================================================
# EventoraX Enterprise Multi-Tenant SaaS & PaaS Configuration
# Deployable to Hostinger, VPS, Docker, AWS, Render, DigitalOcean
# ==============================================================

# Server & Runtime Environment
PORT=5000
NODE_ENV=production

# Multi-Tenant Base Domain (Used for subdomain wildcard routing: *.eventorax.com)
PLATFORM_BASE_DOMAIN=eventorax.com

# Database Settings (Hostinger MySQL or Docker MySQL)
# On Hostinger cPanel / hPanel, host is usually 'localhost'
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=eventorax_db

# Security & Authentication Secret Key
JWT_SECRET=eventorax_enterprise_secret_jwt_key_2025_secure

# Optional Email / SMTP configuration (for ticket QR emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@eventorax.com
SMTP_PASS=your_email_password
