@baseUrl = http://localhost:5000/api/v1
@email = owner@test.com
@password = Test@1234
@token = {{login.response.body.token}}
@inviteToken = f4fb2504279a756fa1cb6366c9e00134743b609ab28aa1a01afc5fedf61fd203
@resetToken = 8839641bb77ddeae15e0451ce5b840ffee49ebe512f876348da33aff3ac33d12
@eventId = {{createEvent.response.body.data.id}}
@copyId = {{duplicateEvent.response.body.data.id}}
@speakerId = {{createSpeaker.response.body.data.id}}
@registrationId = {{addAttendee.response.body.data.id}}

### 1. Health check
GET {{baseUrl}}/health

### 2. Register a new organization
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "fullName": "Test Owner",
  "organizationName": "Test University",
  "email": "{{email}}",
  "phone": "+923001234567",
  "password": "{{password}}"
}

### 3. Login (run this again any time your token stops working)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}", "remember": true }

### 4. Who am I
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### 5. Organization profile
GET {{baseUrl}}/org/me
Authorization: Bearer {{token}}

### 6. Update organization settings
PATCH {{baseUrl}}/org/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "phone": "+923331112222",
  "primaryColor": "#7c3aed",
  "signatoryName": "Dr. Ayesha Khan",
  "notificationPrefs": { "newRegistration": true, "certificate": false }
}

### 7. Enterprise-only feature on a Pro trial (expect 403)
PATCH {{baseUrl}}/org/me
Authorization: Bearer {{token}}
Content-Type: application/json

{ "whiteLabelName": "My Brand" }

### 8. Team list (expect 1 member and seat counts)
GET {{baseUrl}}/team
Authorization: Bearer {{token}}

### 9. Try inviting a superAdmin (expect 400)
POST {{baseUrl}}/team/invite
Authorization: Bearer {{token}}
Content-Type: application/json

{ "email": "hacker@test.com", "role": "superAdmin" }

### 10. Invite a manager (link prints in the SERVER terminal; paste its token into @inviteToken at the top)
POST {{baseUrl}}/team/invite
Authorization: Bearer {{token}}
Content-Type: application/json

{ "email": "manager@test.com", "role": "manager" }
### 10b. Cancel a pending invite
DELETE {{baseUrl}}/team/invites/cmutwifg10007yotjatrdx28u
Authorization: Bearer {{token}}
### 11. Invite details (public)
GET {{baseUrl}}/auth/invite/{{inviteToken}}

### 12. Accept the invite
POST {{baseUrl}}/auth/accept-invite
Content-Type: application/json

{ "token": "{{inviteToken}}", "name": "Test Manager", "password": "Manager@1234" }

### 13. Team list again (expect 2 members, manager seats 1 of 7)
GET {{baseUrl}}/team
Authorization: Bearer {{token}}

### 14. Forgot password (link prints in the SERVER terminal; paste its token into @resetToken at the top)
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{ "email": "{{email}}" }

### 15. Reset password (same value, so the rest of this file keeps working)
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json

{ "token": "{{resetToken}}", "newPassword": "{{password}}" }

### 16. Old token must now fail (expect 401), then re-run request 3
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### 17. Lockout test on a throwaway email: send 6 times (6th = 429)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "nobody@test.com", "password": "wrong" }

### ════════ PHASE 4A: EVENTS ════════

### E1. Create an event with two categories
# @name createEvent
POST {{baseUrl}}/events
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Annual Tech Symposium",
  "organizer": "CS Department",
  "mode": "OFFLINE",
  "startDateTime": "2026-11-20T09:00:00.000Z",
  "endDateTime": "2026-11-20T17:00:00.000Z",
  "location": "Main Auditorium",
  "maxAttendees": 200,
  "categories": ["General", "VIP"]
}

### E2. Invalid: end before start (expect 400 with fieldErrors.endDateTime)
POST {{baseUrl}}/events
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Broken",
  "mode": "ONLINE",
  "startDateTime": "2026-11-20T17:00:00.000Z",
  "endDateTime": "2026-11-20T09:00:00.000Z"
}

### E3. List events (meta has total/page/limit)
GET {{baseUrl}}/events?search=tech&from=2026-11-01&to=2026-11-30
Authorization: Bearer {{token}}

### E4. Event detail with stats
GET {{baseUrl}}/events/{{eventId}}
Authorization: Bearer {{token}}

### E5. Publish it (partial update)
PATCH {{baseUrl}}/events/{{eventId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "status": "PUBLISHED", "topic": "AI & Robotics" }

### E6. Duplicate (expect "(Copy)", DRAFT, categories copied)
# @name duplicateEvent
POST {{baseUrl}}/events/{{eventId}}/duplicate
Authorization: Bearer {{token}}

### E7. Add a category
POST {{baseUrl}}/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{ "eventId": "{{eventId}}", "label": "Speaker" }

### E8. Same category again (expect 409)
POST {{baseUrl}}/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{ "eventId": "{{eventId}}", "label": "Speaker" }

### E9. List categories
GET {{baseUrl}}/categories?eventId={{eventId}}
Authorization: Bearer {{token}}

### S1. Create a speaker
# @name createSpeaker
POST {{baseUrl}}/speakers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "eventId": "{{eventId}}",
  "firstName": "Ayesha",
  "lastName": "Khan",
  "title": "Professor",
  "company": "NUST",
  "sessionTopic": "Future of AI",
  "linkedin": "https://linkedin.com/in/example",
  "displayPublic": true
}

### S2. List speakers
GET {{baseUrl}}/speakers?eventId={{eventId}}
Authorization: Bearer {{token}}

### SP1. Create a sponsor
POST {{baseUrl}}/sponsors
Authorization: Bearer {{token}}
Content-Type: application/json

{ "eventId": "{{eventId}}", "name": "TechCorp", "website": "https://techcorp.pk", "tier": "GOLD" }

### SE1. Create a session with the speaker
POST {{baseUrl}}/sessions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "eventId": "{{eventId}}",
  "speakerId": "{{speakerId}}",
  "title": "Keynote: The Future of AI",
  "startTime": "2026-11-20T09:30:00.000Z",
  "endTime": "2026-11-20T10:30:00.000Z",
  "location": "Hall A"
}

### SE2. List sessions (speaker name included)
GET {{baseUrl}}/sessions?eventId={{eventId}}
Authorization: Bearer {{token}}

### R1. Reorder speakers
POST {{baseUrl}}/reorder
Authorization: Bearer {{token}}
Content-Type: application/json

{ "type": "speakers", "items": [{ "id": "{{speakerId}}", "displayOrder": 5 }] }

### E10. Delete the empty copy (expect deleted: true)
DELETE {{baseUrl}}/events/{{copyId}}
Authorization: Bearer {{token}}

### ════════ PHASE 4B: REGISTRATIONS ════════

### G1. Add an attendee manually (gets a ticket automatically)
# @name addAttendee
POST {{baseUrl}}/registrations
Authorization: Bearer {{token}}
Content-Type: application/json

{ "eventId": "{{eventId}}", "name": "Hamza Raza", "email": "hamza@test.com", "department": "CS", "rollNo": "CS-22-014" }

### G2. Same email again (expect 409 DUPLICATE)
POST {{baseUrl}}/registrations
Authorization: Bearer {{token}}
Content-Type: application/json

{ "eventId": "{{eventId}}", "name": "Hamza Again", "email": "HAMZA@test.com" }

### G3. Parse a CSV (note the quoted name containing a comma)
POST {{baseUrl}}/registrations/csv-import/parse
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=EVXBOUNDARY

--EVXBOUNDARY
Content-Disposition: form-data; name="file"; filename="attendees.csv"
Content-Type: text/csv

name,email,phone,category
"Khan, Ali",ali@test.com,03001234567,VIP
Sara Ahmed,sara@test.com,,General
--EVXBOUNDARY--

### G4. Confirm an import (mixed good and bad rows)
POST {{baseUrl}}/registrations/csv-import/confirm
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "eventId": "{{eventId}}",
  "rows": [
    { "name": "Khan, Ali", "email": "ali@test.com", "phone": "03001234567", "categoryLabel": "VIP" },
    { "name": "Sara Ahmed", "email": "sara@test.com", "categoryLabel": "General" },
    { "name": "Bilal Shah", "email": "bilal@test.com", "categoryLabel": "Press" },
    { "name": "Hamza Copy", "email": "hamza@test.com" },
    { "name": "Bad Email", "email": "not-an-email" },
    { "name": "Ali Twice", "email": "ali@test.com" }
  ]
}

### G5. List registrations (each has category + ticket)
GET {{baseUrl}}/registrations?eventId={{eventId}}
Authorization: Bearer {{token}}

### G6. One registration
GET {{baseUrl}}/registrations/{{registrationId}}
Authorization: Bearer {{token}}

### G7. Mark attended
PATCH {{baseUrl}}/registrations/{{registrationId}}/attendance
Authorization: Bearer {{token}}
Content-Type: application/json

{ "status": "ATTENDED" }

### G8. Event stats now (1 attended, attendance rate 25%)
GET {{baseUrl}}/events/{{eventId}}
Authorization: Bearer {{token}}

### G9. Export CSV
GET {{baseUrl}}/registrations/export?eventId={{eventId}}&format=csv
Authorization: Bearer {{token}}

### G10. Export Excel (expect 200 + Content-Disposition ...xlsx; the body is binary)
GET {{baseUrl}}/registrations/export?eventId={{eventId}}&format=xlsx
Authorization: Bearer {{token}}

### G11. Email the attendee (prints in the SERVER terminal)
POST {{baseUrl}}/registrations/email
Authorization: Bearer {{token}}
Content-Type: application/json

{ "ids": ["{{registrationId}}"], "subject": "Venue update", "message": "Hi!\nThe symposium moves to Hall B." }

### G12. Shrink capacity to 4 (4 people are registered now)
PATCH {{baseUrl}}/events/{{eventId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "maxAttendees": 4 }

### G13. One more attendee (expect 409 EVENT_FULL)
POST {{baseUrl}}/registrations
Authorization: Bearer {{token}}
Content-Type: application/json

{ "eventId": "{{eventId}}", "name": "Late Comer", "email": "late@test.com" }

### G14. Try deleting the event (expect archived: true, because it has registrations)
DELETE {{baseUrl}}/events/{{eventId}}
Authorization: Bearer {{token}}

### ════════ PHASE 7.5: BACKEND ════════

### X1. Restore the archived event (upcoming → DRAFT)
POST {{baseUrl}}/events/{{eventId}}/restore
Authorization: Bearer {{token}}

### X2. Restore again (expect 409 NOT_ARCHIVED)
POST {{baseUrl}}/events/{{eventId}}/restore
Authorization: Bearer {{token}}

### X3. Events overview cards
GET {{baseUrl}}/events/stats
Authorization: Bearer {{token}}

### X4. Everything about one event
GET {{baseUrl}}/events/{{eventId}}/stats
Authorization: Bearer {{token}}

### X5. Speakers list now has meta.total
GET {{baseUrl}}/speakers?eventId={{eventId}}&limit=1
Authorization: Bearer {{token}}

### X6. Cancel one registration (frees a seat)
PATCH {{baseUrl}}/registrations/{{registrationId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{ "status": "CANCELLED" }

### X7. Bulk mark attended on that cancelled row (expect affected 0, skipped 1)
POST {{baseUrl}}/registrations/bulk
Authorization: Bearer {{token}}
Content-Type: application/json

{ "action": "mark_attended", "ids": ["{{registrationId}}"] }

### X8. Bulk restore it (seat is free again → affected 1)
POST {{baseUrl}}/registrations/bulk
Authorization: Bearer {{token}}
Content-Type: application/json

{ "action": "restore", "ids": ["{{registrationId}}"] }

### X9. Give the event room for the import tests
PATCH {{baseUrl}}/events/{{eventId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "maxAttendees": 50 }

### X10. CSV dry run: one bad email, duplicate emails, same-name warning, unknown category
POST {{baseUrl}}/registrations/csv-import/confirm
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "eventId": "{{eventId}}",
  "dryRun": true,
  "duplicateStrategy": "last",
  "rows": [
    { "name": "Zara Malik", "email": "zara@test.com", "categoryLabel": "VIP" },
    { "name": "Bad Row", "email": "nope" },
    { "name": "Omar First", "email": "omar@test.com" },
    { "name": "Omar Second", "email": "omar@test.com" },
    { "name": "Ali Raza", "email": "ali.raza1@test.com" },
    { "name": "ali  raza", "email": "ali.raza2@test.com", "categoryLabel": "Press" }
  ]
}

### X11. Same rows for real, creating the missing "Press" category
POST {{baseUrl}}/registrations/csv-import/confirm
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "eventId": "{{eventId}}",
  "duplicateStrategy": "last",
  "createMissingCategories": true,
  "rows": [
    { "name": "Zara Malik", "email": "zara@test.com", "categoryLabel": "VIP" },
    { "name": "Bad Row", "email": "nope" },
    { "name": "Omar First", "email": "omar@test.com" },
    { "name": "Omar Second", "email": "omar@test.com" },
    { "name": "Ali Raza", "email": "ali.raza1@test.com" },
    { "name": "ali  raza", "email": "ali.raza2@test.com", "categoryLabel": "Press" }
  ]
}