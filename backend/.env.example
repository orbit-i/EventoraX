# Database (you'll fill the real password in Phase 2)
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/eventorax"
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=eventorax

# Auth
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# App
PORT=5000
FRONTEND_URL=http://localhost:5173

# Email (Gmail app password - fill later)
EMAIL_USER=
EMAIL_PASS=

# Logo storage - placeholders so the server can start
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder

# ─── Seed: superadmin account created by `npx prisma db seed` ───
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=