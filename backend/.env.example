# EventoraX backend settings. Copy this file to `.env` and fill it in.
# Never commit `.env`: it holds passwords and secrets.

# ─── Database (MySQL 8) ───
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/eventorax"
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=eventorax

# ─── Security ───
# Signs login tokens. At least 32 random characters. Changing it logs everyone out.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Encrypts stored secrets (SMTP password, two-factor keys). Optional: if empty it is derived from JWT_SECRET.
# Set it once before going live and never change it (stored secrets would stop working).
ENCRYPTION_KEY=

# ─── App ───
PORT=5000
# The public address of the website (links in emails, link previews). Production: https://your-domain
FRONTEND_URL=http://localhost:5173
# "production" on the live server (HTTPS-only headers, real link-preview URLs, blocks the demo seed)
NODE_ENV=development

# ─── Email (SMTP) ───
# Leave EMAIL_USER / EMAIL_PASS empty during development: emails are printed in the terminal as "DEV EMAIL".
# Gmail: EMAIL_PASS is a 16-character app password, not the normal password.
# The superadmin can also set an SMTP server in the app (Superadmin → Email templates → SMTP server); that wins over these.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ─── Files ───
# Public uploads (logos, photos, receipts), served at /uploads
UPLOAD_DIR=uploads
# Optional overrides (defaults shown):
# PRIVATE_DIR=private-files      certificate PDFs, never served directly
# BACKUP_DIR=../backups          database backups made from Superadmin → Maintenance
# MYSQLDUMP_PATH=                full path to mysqldump if it is not found automatically
# WEB_DIST=../dist               the built website the backend serves in production

# ─── Superadmin account created by `npx prisma db seed` ───
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
