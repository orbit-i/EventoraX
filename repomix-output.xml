<file path="prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Event {
  id               String          @id @default(cuid())
  tenantId         String
  title            String
  organizer        String?
  mode             EventMode
  startDateTime    DateTime
  endDateTime      DateTime
  location         String?
  description      String?         @db.Text
  topic            String?
  maxAttendees     Int?
  ticketPrice      Decimal?        @db.Decimal(10, 2)
  registrationOpen Boolean         @default(true)
  meetingLink      String?
  certTemplateId   String?
  autoIssueCert    Boolean         @default(false)
  status           EventStatus     @default(DRAFT)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  categories       EventCategory[]
  registrations    Registration[]
  sessions         Session[]
  speakers         Speaker[]
  sponsors         Sponsor[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("events")
}

model EventCategory {
  id            String         @id @default(cuid())
  tenantId      String
  eventId       String
  label         String
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@unique([eventId, label])
  @@index([tenantId])
  @@index([eventId])
  @@map("event_categories")
}

model Registration {
  id               String             @id @default(cuid())
  tenantId         String
  eventId          String
  categoryId       String?
  refNo            String             @unique
  name             String
  email            String
  phone            String?
  department       String?
  rollNo           String?
  registeredVia    RegisteredVia      @default(WEB)
  status           RegistrationStatus @default(REGISTERED)
  registrationDate DateTime           @default(now())
  ticketId         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  category         EventCategory?     @relation(fields: [categoryId], references: [id])
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([tenantId])
  @@index([eventId])
  @@index([eventId, status])
  @@index([categoryId], map: "registrations_categoryId_fkey")
  @@map("registrations")
}

model Speaker {
  id            String    @id @default(cuid())
  tenantId      String
  eventId       String
  firstName     String
  lastName      String
  title         String?
  company       String?
  sessionTopic  String?
  bio           String?   @db.Text
  photo         String?
  linkedin      String?
  displayPublic Boolean   @default(false)
  displayOrder  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([eventId])
  @@map("speakers")
}

model Sponsor {
  id            String      @id @default(cuid())
  tenantId      String
  eventId       String
  name          String
  website       String?
  logo          String?
  tier          SponsorTier @default(BRONZE)
  displayPublic Boolean     @default(false)
  displayOrder  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([eventId])
  @@index([eventId, tier])
  @@map("sponsors")
}

model Session {
  id            String   @id @default(cuid())
  tenantId      String
  eventId       String
  speakerId     String?
  title         String
  startTime     DateTime
  endTime       DateTime
  location      String?
  displayPublic Boolean  @default(false)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker       Speaker? @relation(fields: [speakerId], references: [id])

  @@index([tenantId])
  @@index([eventId])
  @@index([speakerId], map: "sessions_speakerId_fkey")
  @@map("sessions")
}

enum EventMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  ARCHIVED
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  ABSENT
  CANCELLED
}

enum RegisteredVia {
  WEB
  ADMIN
  CSV_IMPORT
  API
}

enum SponsorTier {
  PLATINUM
  GOLD
  SILVER
  BRONZE
}
</file>

